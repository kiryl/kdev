# Activate the kdev devShell whenever you cd into this directory or any
# subdirectory. Edit the flake reference below to point at wherever you
# checked out (or otherwise made available) the kdev flake:
#
#   use flake ~/git/kdev          # local checkout
#   use flake github:OWNER/kdev   # if you've forked/published it
#   use flake path:/abs/to/kdev   # explicit absolute path
use flake ~/git/kdev

# Re-evaluate the shell whenever any of these source files change.
# Without this, nix-direnv only watches flake.{nix,lock} at the flake
# root and edits to kdev.nix / vm.nix / checks.nix won't reload.
nix_direnv_watch_file ~/git/kdev/flake.nix \
                      ~/git/kdev/kdev.nix \
                      ~/git/kdev/vm.nix \
                      ~/git/kdev/checks.nix
